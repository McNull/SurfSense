# ============================================================================
# DOCKER INFRASTRUCTURE CONFIGURATION
# ============================================================================

# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>
POSTGRES_DB=surfsense
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# pgAdmin
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@surfsense.com
PGADMIN_DEFAULT_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>

# Service Ports (host mapping)
BACKEND_PORT=8000
FRONTEND_PORT=3000
FLOWER_PORT=5555

# ============================================================================
# BACKEND APPLICATION CONFIGURATION
# ============================================================================

# Database Connection (uses Docker service names)
# Note: Uses 'db' service name, not 'localhost'
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# Celery Configuration
# Note: Uses 'redis' service name, not 'localhost'
CELERY_BROKER_URL=redis://redis:${REDIS_PORT}/0
CELERY_RESULT_BACKEND=redis://redis:${REDIS_PORT}/0
SCHEDULE_CHECKER_INTERVAL=5m

# Application Security
# Generate with: openssl rand -hex 32
SECRET_KEY=<CHANGE_ME_GENERATE_STRONG_SECRET>
NEXT_FRONTEND_URL=http://frontend:3000

# Authentication
# Options: LOCAL or GOOGLE
AUTH_TYPE=LOCAL
# Options: TRUE or FALSE
REGISTRATION_ENABLED=TRUE

# Google OAuth (required only if AUTH_TYPE=GOOGLE)
GOOGLE_OAUTH_CLIENT_ID=<YOUR_GOOGLE_CLIENT_ID>
GOOGLE_OAUTH_CLIENT_SECRET=<YOUR_GOOGLE_CLIENT_SECRET>

# Connector OAuth Callbacks
# Update with your production domain
GOOGLE_CALENDAR_REDIRECT_URI=https://surfsense.at.nullest.com/api/v1/auth/google/calendar/connector/callback
GOOGLE_GMAIL_REDIRECT_URI=https://surfsense.at.nullest.com/api/v1/auth/google/gmail/connector/callback
AIRTABLE_CLIENT_ID=<YOUR_AIRTABLE_CLIENT_ID>
AIRTABLE_CLIENT_SECRET=<YOUR_AIRTABLE_CLIENT_SECRET>
AIRTABLE_REDIRECT_URI=https://surfsense.at.nullest.com/api/v1/auth/airtable/connector/callback

# Embedding Model
# Examples:
#   sentence-transformers/all-MiniLM-L6-v2 (local, default)
#   openai://text-embedding-ada-002 (requires OpenAI API key)
#   anthropic://claude-v1 (requires Anthropic API key)
#   cohere://embed-english-light-v3.0 (requires Cohere API key)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Rerankers Configuration
# Options: TRUE or FALSE
RERANKERS_ENABLED=FALSE
RERANKERS_MODEL_NAME=ms-marco-MiniLM-L-12-v2
RERANKERS_MODEL_TYPE=flashrank

# TTS (Text-to-Speech) Configuration
# Options:
#   local/kokoro (local Kokoro TTS, default)
#   LiteLLM providers (see: https://docs.litellm.ai/docs/text_to_speech)
TTS_SERVICE=local/kokoro
# TTS_SERVICE_API_KEY=<YOUR_TTS_API_KEY>
# TTS_SERVICE_API_BASE=<OPTIONAL_API_BASE>

# STT (Speech-to-Text) Configuration
# Options for local:
#   local/tiny, local/base, local/small, local/medium, local/large-v3
# LiteLLM providers (see: https://docs.litellm.ai/docs/audio_transcription)
#   openai/whisper-1
STT_SERVICE=local/base
# STT_SERVICE_API_KEY=<YOUR_STT_API_KEY>
# STT_SERVICE_API_BASE=<OPTIONAL_API_BASE>

# External API Keys
FIRECRAWL_API_KEY=<YOUR_FIRECRAWL_API_KEY>

# File Parser Service
# Options: UNSTRUCTURED, LLAMACLOUD, DOCLING
ETL_SERVICE=DOCLING
UNSTRUCTURED_API_KEY=<YOUR_UNSTRUCTURED_API_KEY>
LLAMA_CLOUD_API_KEY=<YOUR_LLAMA_CLOUD_API_KEY>

# LangSmith Observability (optional)
# Set to 'true' to enable tracing
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=<YOUR_LANGSMITH_API_KEY>
LANGSMITH_PROJECT=surfsense

# Uvicorn Server Configuration
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000
UVICORN_LOG_LEVEL=info

# Advanced Uvicorn Options (uncomment to use)
# UVICORN_PROXY_HEADERS=false
# UVICORN_FORWARDED_ALLOW_IPS="127.0.0.1"
# UVICORN_WORKERS=1
# UVICORN_ACCESS_LOG=true
# UVICORN_LOOP="auto"
# UVICORN_HTTP="auto"
# UVICORN_WS="auto"
# UVICORN_LIFESPAN="auto"
# UVICORN_LIMIT_CONCURRENCY=
# UVICORN_LIMIT_MAX_REQUESTS=
# UVICORN_TIMEOUT_KEEP_ALIVE=5
# UVICORN_TIMEOUT_NOTIFY=30

# ============================================================================
# FRONTEND APPLICATION CONFIGURATION
# ============================================================================

# Public Environment Variables (embedded at build time - requires rebuild to change!)
# IMPORTANT: These are baked into the frontend build and cannot be changed at runtime
NEXT_PUBLIC_FASTAPI_BACKEND_URL=https://surfsense.at.nullest.com/api
# Options: LOCAL or GOOGLE
NEXT_PUBLIC_FASTAPI_BACKEND_AUTH_TYPE=LOCAL
# Options: UNSTRUCTURED, LLAMACLOUD, DOCLING
NEXT_PUBLIC_ETL_SERVICE=DOCLING

# Optional: Contact Form Database (if using external DB like Supabase)
# FRONTEND_DATABASE_URL=postgresql://postgres:password@external-db.supabase.co:5432/postgres

# ============================================================================
# IMAGE CONFIGURATION
# ============================================================================

# Image Registry and Tags
DOCKER_REGISTRY=docker.at.nullest.com
BACKEND_IMAGE_TAG=0.0.8
FRONTEND_IMAGE_TAG=0.0.8
